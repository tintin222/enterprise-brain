# ── Enterprise Brain configuration ────────────────────────────────────────────
# Copy to .env (or export the variables) and adjust. Everything is optional for a local demo.

# Claude (Anthropic API). Without credentials the platform runs in offline mode with
# deterministic fallbacks. `ant auth login` profiles also work: set EB_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# EB_LLM_PROVIDER=anthropic        # anthropic | offline
# EB_LLM_MODEL=claude-opus-5       # default model
# EB_LLM_EFFORT=                   # default effort when a call doesn't set one (low|medium|high|xhigh|max)
# EB_LLM_FALLBACKS=on              # server-side refusal fallbacks ("off" to disable)

# Embeddings for the knowledge base (1024 dimensions). Default: offline hashing embedder.
# VOYAGE_API_KEY=                  # Voyage AI (voyage-3.5), recommended
# OPENAI_API_KEY=                  # or OpenAI text-embedding-3-small
# EB_EMBEDDINGS_PROVIDER=          # voyage | openai | local

# Server
PORT=3200
HOST=127.0.0.1
EB_PUBLIC_URL=http://localhost:3200   # used in stakeholder answer links and Paperclip adapter config
EB_DATA_DIR=./.data                   # embedded database, files, master key
# DATABASE_URL=postgres://user:pass@host:5432/enterprise_brain   # PostgreSQL with pgvector (production)

# Security (leave EB_API_KEY empty for local trusted mode)
EB_API_KEY=
EB_HERMES_API_KEY=                    # key Paperclip's hermes_gateway adapter sends (defaults to EB_API_KEY)
EB_MASTER_KEY=                        # encrypts connector secrets (default: generated key file in EB_DATA_DIR)

# Demo company
EB_COMPANY_SLUG=acme
EB_COMPANY_NAME=Acme Endüstri A.Ş.
EB_MAIL_DOMAIN=acme.com.tr            # replaces the templates' placeholder addresses (careers@company.com)
EB_SEED_DEMO=true                     # install templates + demo knowledge, mailboxes and samples on first start
EB_SCHEDULER=true                     # run schedule triggers

# Paperclip (optional: enables "Push to Paperclip")
# PAPERCLIP_URL=http://localhost:3100
# PAPERCLIP_API_KEY=
