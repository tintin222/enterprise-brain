# ── Enterprise Brain configuration ────────────────────────────────────────────
# Copy to .env (or export the variables) and adjust. Everything is optional for a local demo.

# Claude (Anthropic API). Without credentials the platform runs in offline mode with
# deterministic fallbacks. `ant auth login` profiles also work: set EB_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# EB_LLM_PROVIDER=anthropic        # anthropic | offline
# EB_LLM_MODEL=claude-opus-5-5     # default model
# EB_LLM_EFFORT=medium             # effort when a call doesn't set one (low|medium|high|xhigh|max)
# EB_LLM_FALLBACKS=on              # server-side refusal fallbacks ("off" to disable)

# Embeddings for the knowledge base (1024 dimensions). Default: offline hashing embedder.
# VOYAGE_API_KEY=                  # Voyage AI (voyage-3.5), recommended
# OPENAI_API_KEY=                  # or OpenAI text-embedding-3-small
# EB_EMBEDDINGS_PROVIDER=          # voyage | openai | local

# Docker (docker compose up -d): where the app is published on this computer.
# EB_BIND=127.0.0.1                  # 0.0.0.0 lets colleagues reach it (create the admin account first)
# EB_PORT=3200

# Server
PORT=3200
HOST=127.0.0.1
EB_PUBLIC_URL=http://localhost:3200   # used in stakeholder answer links and Paperclip adapter config
EB_DATA_DIR=./.data                   # embedded database, files, master key
# Database: unset = embedded PostgreSQL in EB_DATA_DIR (nothing to install).
# For a PostgreSQL server (15+), a superuser first runs once in the database: CREATE EXTENSION vector;
# DATABASE_URL=postgres://user:pass@host:5432/enterprise_brain

# Sign-in. accounts (default): people sign in (password, Microsoft, Google); the first person to open a new
# installation becomes the admin, and demo installations list the demo people for one-click sign-in.
# open: no sign-in, everyone acts as the owner (local trials; the Paperclip bundle, docker-compose.paperclip.yml, uses it
# with Paperclip's local_trusted mode).
# EB_AUTH=accounts
# EB_SESSION_HOURS=12
# Microsoft Entra ID and Google sign-in can also be set up in the app (Settings → People and roles), which overrides these.
# Redirect URI to register: <EB_PUBLIC_URL>/api/auth/oidc/microsoft/callback (…/google/callback for Google).
# EB_AUTH_MICROSOFT_CLIENT_ID=
# EB_AUTH_MICROSOFT_CLIENT_SECRET=
# EB_AUTH_MICROSOFT_TENANT=          # required: the directory (tenant) id or primary domain, e.g. acme.com.tr
# EB_AUTH_GOOGLE_CLIENT_ID=
# EB_AUTH_GOOGLE_CLIENT_SECRET=
# EB_AUTH_GOOGLE_HOSTED_DOMAIN=      # only accounts of this Google Workspace domain

# Machines (MCP clients, scripts) send EB_API_KEY as a Bearer token; it acts as an admin.
# With EB_AUTH=open, setting it protects the console with the key instead (it asks for it).
EB_API_KEY=
# Shared secret Paperclip's hermes_gateway adapter sends to Enterprise Brain. You choose it (e.g. openssl rand -hex 32);
# unset = EB_API_KEY, else a key generated once in EB_DATA_DIR/hermes.key (shown on the console's Paperclip page).
EB_HERMES_API_KEY=
EB_MASTER_KEY=                        # encrypts connector secrets (default: generated key file in EB_DATA_DIR)

# Demo company
EB_COMPANY_SLUG=acme
EB_COMPANY_NAME=Acme Endüstri A.Ş.
EB_MAIL_DOMAIN=acme.com.tr            # replaces the templates' placeholder addresses (careers@company.com)
EB_SEED_DEMO=true                     # install templates + demo knowledge, mailboxes and samples on first start
EB_SCHEDULER=true                     # run schedule triggers, wake waiting tasks, watch mailboxes and systems
# EB_WATCH_INTERVAL=60                # seconds between checks of connected mailboxes and systems
# EB_SHARED_FOLDER_ROOTS=/mnt/shares  # folders shared-folder connections may use (mounted network drives), separated by ':'

# Paperclip (optional: enables "Push to Paperclip")
# PAPERCLIP_URL=http://localhost:3100
# PAPERCLIP_API_KEY=                  # board API key; not needed for a Paperclip in local_trusted mode
# EB_PAPERCLIP_AUTOCONNECT=false      # true: on start, push the company once and install + configure the plugin
# EB_PAPERCLIP_PLUGIN_DIR=            # a folder Paperclip can read; the plugin is copied there before installing

# Docker bundle (docker-compose.yml) only
# PAPERCLIP_PORT=3100                 # Paperclip at http://localhost:3100
# EB_PORT=3200                        # Enterprise Brain at http://localhost:3200
# POSTGRES_PASSWORD=brain             # the bundle's PostgreSQL (not published outside Docker)
# PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:latest
# OPENAI_API_KEY=                     # passed to Paperclip for its own agents (with ANTHROPIC_API_KEY)
