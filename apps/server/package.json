    "@enterprise-brain/paperclip": "workspace:*",
    "@enterprise-brain/runtime": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@modelcontextprotocol/sdk": "^1.30.1",
